# ========== Frontend (Vite, browser-safe) ==========
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=

# ========== Server / Vercel only ==========
# The fully-qualified URL where this site is hosted.
# REQUIRED in production so that the OAuth redirect_uri matches Meta App.
APP_URL=https://dmflow.site

# Instagram / Facebook Login for Business
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Meta webhook
# A random string you choose; paste the same value into your Meta App's
# webhook verify-token field.
META_VERIFY_TOKEN=
# Your Meta App secret, for x-hub-signature-256 verification.
META_APP_SECRET=

# Supabase service-role key (server only, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (used by AI auto-replies). Optional — leave blank to disable AI.
GEMINI_API_KEY=

# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dodo Payments (International)
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_KEY=
DODO_PRODUCT_ID_CREATOR=
DODO_PRODUCT_ID_PRO=

# Optional: secret to gate /api/cron/* endpoints
CRON_SECRET=
